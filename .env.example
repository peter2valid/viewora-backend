# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Anon/public key (NOT the service key) — used only to mint anonymous
# sessions for bot conversations, see src/conversation/anonymousAuth.ts
SUPABASE_ANON_KEY=your-anon-key

# Conversation bot (Telegram — build/test channel, no verification required)
# Get one from @BotFather on Telegram: message it, /newbot, copy the token.
TELEGRAM_BOT_TOKEN=
# Base URL the conversation engine calls back into itself on
# (POST /spaces, /uploads/*) — defaults to http://localhost:$PORT, only set
# this if the bot process is separate from the main API process.
INTERNAL_API_BASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_BUCKET_NAME=viewora-tours
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
MEDIA_DOMAIN=https://media.viewora.software

# Paystack
PAYSTACK_SECRET_KEY=sk_live_your-key

# Redis (BullMQ job queue + auth/billing cache)
REDIS_URL=redis://default:password@localhost:6379

# App
PORT=3001
NODE_ENV=production
# URL of the dashboard app — used for Paystack payment callback redirect
APP_URL=https://app.viewora.software
CORS_ORIGIN=https://viewora.software,https://app.viewora.software,https://viewora.vercel.app

# Security
# Random secret shared between the API server and the tile worker
WORKER_SECRET=generate-a-random-secret-here
# Key required to call the /maintenance/sync-limits endpoint
MAINTENANCE_KEY=generate-a-random-key-here
# Token required to scrape the /metrics endpoint (leave unset to disable auth)
METRICS_TOKEN=

# Email (Resend)
RESEND_API_KEY=re_your-api-key

# Anthropic (AI scene analysis — required for auto-link feature)
ANTHROPIC_API_KEY=sk-ant-your-key

# Sentry (optional — leave blank to disable error tracking)
SENTRY_DSN=

# PostHog (optional — leave blank to disable server-side analytics)
# Use your PostHog project API key. If self-hosted, set POSTHOG_HOST to your instance URL.
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# PostHog (optional — leave blank to disable server-side analytics)
POSTHOG_API_KEY=
